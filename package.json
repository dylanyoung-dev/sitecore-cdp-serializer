{
  "name": "sitecore-cdp-serializer",
  "version": "0.2.1",
  "description": "A Sitecore CDP/Personalize Serialization tool to abstract the APIs related to Tenant asset management and automated deployments from Source Control and/or physical files",
  "type": "module",
  "exports": "./dist/index.js",
  "bin": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "nodemon --watch 'src/**/*.ts' --exec 'npx ts-node' ./src/bin/index.ts",
    "start:windows": "ts-node-dev ./src/bin/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dylanyoung-dev/sitecore-cdp-serializer.git"
  },
  "engines": {
    "node": ">=16.17",
    "npm": ">=8.15.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dylanyoung-dev/sitecore-cdp-serializer/issues"
  },
  "homepage": "https://github.com/dylanyoung-dev/sitecore-cdp-serializer#readme",
  "dependencies": {
    "chalk": "4.1.2",
    "commander": "^9.4.0",
    "configstore": "6.0.0",
    "js-yaml": "4.1.0",
    "json-diff": "0.9.0",
    "node-fetch": "3.2.10",
    "ora": "^8.0.1",
    "unzipper": "^0.10.14"
  },
  "devDependencies": {
    "@types/configstore": "6.0.0",
    "@types/js-yaml": "4.0.5",
    "@types/json-diff": "0.7.0",
    "@types/node": "18.6.3",
    "@types/unzipper": "^0.10.9",
    "copyfiles": "^2.4.1",
    "nodemon": "^2.0.19",
    "tsup": "^6.6.3",
    "typescript": "^4.7.4"
  }
}
